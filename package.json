{
  "name": "rateio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rateio – divida despesas com amigos (clone do Splitwise)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:cloud": "npx -y firebase-tools@15.34.0 emulators:exec --project demo-rateio --only firestore,auth \"vitest run tests/cloud.test.ts\"",
    "build:cloud-test": "VITE_FIREBASE_CONFIG='{\"apiKey\":\"demo-key\",\"authDomain\":\"demo-rateio.firebaseapp.com\",\"projectId\":\"demo-rateio\"}' VITE_FIREBASE_EMULATOR=localhost vite build --outDir dist-cloud",
    "test:e2e-cloud": "npm run build:cloud-test && npx -y firebase-tools@15.34.0 emulators:exec --project demo-rateio --only firestore,auth \"node scripts/e2e-cloud.mjs\"",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:e2e-post": "npm run build && node scripts/e2e-post-pronto.mjs",
    "build:artifact": "node scripts/build-post-pronto-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource/lato": "5.3.0",
    "firebase": "13.0.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "^1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
